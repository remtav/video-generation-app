# Copy to .env and adjust. Read by docker compose.
POSTGRES_PASSWORD=change-me
# 127.0.0.1 = this machine only. Use the host's LAN IP to reach the app from other devices.
BIND_ADDR=127.0.0.1
# Engine: compose.yml defaults to "fake" (CPU stand-in), compose.gpu.yml to "wan".
# VIDGEN_ENGINE=wan
# Wan memory mode on the GPU: model (default, fits 24 GB at 720p), sequential (lowest VRAM,
# much slower) or none (everything on the GPU; fastest, may not fit).
# VIDGEN_WAN_OFFLOAD=model
# Host directory for model weights (GPU override only; must be writable by uid 1000).
# Defaults to a Docker volume named "models".
# MODELS_DIR=/srv/vidgen/models
