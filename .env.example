# Copy to .env and adjust. Read by docker compose.
POSTGRES_PASSWORD=change-me
# 127.0.0.1 = this machine only. Use the host's LAN IP to reach the app from other devices.
BIND_ADDR=127.0.0.1
# fake (CPU stand-in) or wan (Wan 2.2 on the GPU, available from Phase 2)
VIDGEN_ENGINE=fake
# Host directory for downloaded model weights (GPU override only)
MODELS_DIR=./models
